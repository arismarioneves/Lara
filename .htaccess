# Lara — Apache 2.4
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset utf-8

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/wasm .wasm
</IfModule>

# Código, banco, segredos e dados privados nunca são servidos
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(src|database|bin|storage|tests)(/|$) - [F,L]
</IfModule>
<FilesMatch "^(config\.php(\.tmp)?|README\.md|LICENSE)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=()"
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>
